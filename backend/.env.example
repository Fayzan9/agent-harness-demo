# Copy to backend/.env and fill in. Never commit the real .env (it is in .gitignore).
# On a server these are real environment variables instead of a file.

# Required: the app refuses to start without these three.
OPENAI_API_BASE=https://<your-resource>.openai.azure.com
OPENAI_API_KEY=<your-azure-openai-key>
MODEL=<your-azure-deployment-name>

# Optional (defaults shown).
# OPENAI_API_VERSION=2025-04-01-preview
# ENVIRONMENT=local                      # local | staging | production
# CORS_ORIGINS=["http://localhost:3000"] # JSON list of browser origins allowed to call the API

# Database. Default is a local SQLite file (backend/data/harness.db). Staging/production require Postgres.
# Local Postgres:  docker run -d --name harness-db -e POSTGRES_USER=harness -e POSTGRES_PASSWORD=<pick-one> -e POSTGRES_DB=harness -p 127.0.0.1:5432:5432 postgres:16
# DATABASE_URL=postgresql+psycopg://harness:<password>@127.0.0.1:5432/harness

# Login. Off by default for local use. In staging/production the app refuses to start with AUTH_MODE=off.
# AUTH_MODE=jwt
# AUTH_AUDIENCE=<google-oauth-client-id>.apps.googleusercontent.com  # Google Cloud Console > Credentials (not a secret)
# ALLOWED_EMAILS=["you@company.com", "@company.com"]               # exact emails or @domain; required when AUTH_MODE=jwt
